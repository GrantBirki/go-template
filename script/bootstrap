#!/usr/bin/env bash

set -euo pipefail

source script/env "$@"

echo -e "${BLUE}🥾 Bootstrapping...${OFF}"

# Build goreleaser from vendored source so CI stays offline and reproducible
ensure_goreleaser() {
  if command -v goreleaser >/dev/null 2>&1; then
    return
  fi

  GORELEASER_VERSION=$(go list -m -mod=vendor -f '{{.Version}}' github.com/goreleaser/goreleaser/v2)
  echo "Using goreleaser version ${GORELEASER_VERSION}"
  go build -mod=vendor -tags=tools -o "${DIR}/vendor_bin/goreleaser" github.com/goreleaser/goreleaser/v2
}

ensure_goreleaser

# Hermetic check: ensure all imports resolve from vendor/ only
# This avoids touching the network or the module cache.
go list -mod=vendor -deps ./... > /dev/null

echo -e "${GREEN}✅ Bootstrap complete!${OFF}"
